{
  "expo": {
    "name": "SwiftDrive Driver FL",
    "slug": "swiftdrivedriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#060E1A"
    },
    "android": {
      "backgroundColor": "#060E1A",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35"
      },
      "package": "com.swiftdrivedriver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyARjitdG1PXYmsk_L79FuJQUSyAxbBY7OM"
        }
      }
    },
    "ios": {
      "backgroundColor": "#060E1A"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SwiftDrive needs your location to show you on the map and receive ride requests."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "SwiftDrive Driver needs camera access to scan parcel barcodes at pickup."
        }
      ]
    ]
  }
}